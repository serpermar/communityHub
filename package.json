{
  "name": "communityhub",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.3"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky",
    "format": "prettier --write"
  },
  "lint-staged": {
    "backend/**/*.{ts,tsx,js,jsx}": [
      "npm --prefix backend run lint:staged",
      "npm --prefix backend run format:staged"
    ],
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "npm --prefix frontend run lint:staged",
      "npm --prefix frontend run format:staged"
    ],
    "frontend/**/*.css": [
      "npm --prefix frontend run format:staged"
    ],
    "*.{json,md,yml,yaml}": [
      "npx prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serpermar/communityHub.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/serpermar/communityHub/issues"
  },
  "homepage": "https://github.com/serpermar/communityHub#readme"
}
