# ---------------------------------------------------------------------------
# Plantilla de variables de entorno del BACKEND.
#
# Copia este archivo a .env en la MISMA carpeta (backend/):
#
#     copy .env.example .env        (Windows PowerShell / CMD)
#     cp .env.example .env          (bash, macOS, Linux)
#
# .env está en .gitignore y no debe subirse nunca al repositorio.
# Este archivo sí se sube, y por eso solo contiene la estructura: ningún valor
# real. Si alguna vez necesitas corregir algo, edita .env, no este archivo.
#
# Todas las variables se validan al arrancar (src/config/env.ts). Si algo está
# mal, el servidor no levanta y el error dice qué variable y por qué.
# ---------------------------------------------------------------------------


# --- Aplicación --------------------------------------------------------------

NODE_ENV="development"
PORT=3000
LOG_LEVEL="info"

# Orígenes permitidos por CORS, separados por comas. En desarrollo, el frontend.
CORS_ORIGINS="http://localhost:5173"

# Solo si hay un proxy inverso delante (Nginx, Fly, Railway...). Con true, el
# servidor lee X-Forwarded-For para saber la IP real del cliente, y con eso
# funcionan el rate limit por IP y el user_agent de las sesiones.
# Incorrecto en local, la app corre sin proxy: déjalo en false.
TRUST_PROXY="false"


# --- Base de datos ----------------------------------------------------------
#
# Dos conexiones distintas, y el orden importa más de lo que parece.
#
#   DATABASE_URL          -> la usa Prisma Client en CADA petición. Debe ser el
#                            rol app_runtime, porque es el unico al que RLS le
#                            limita de verdad.
#   MIGRATION_DATABASE_URL -> solo para leer el catalogo (prisma db pull), el
#                            seed, los fixtures de los tests y db:apply. Es el
#                            rol postgres, que tiene BYPASSRLS.
#
# Si se invierten, la app sigue funcionando y devuelve datos de otras
# comunidades. No hay ningun error visible: solo un test de aislamiento fallara.
# env.ts lo comprueba al arrancar y se niega a continuar.
#
# Origen: Supabase Dashboard -> Connect -> Session pooler -> URI.
# Sustituye [PASSWORD] por tu contraseña, percent-codificada.

# Usuario de la app. El sufijo .PROJECT_REF es obligatorio en el pooler:
# sin el, Supavisor responde "Tenant or user not found".
#   postgresql://app_runtime.ABCDEFGHIJKLMNOP:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL="postgresql://app_runtime.TU_PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# Rol de administracion. Solo para db pull, seed, fixtures y db:apply.
#   postgresql://postgres.ABCDEFGHIJKLMNOP:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL="postgresql://postgres.TU_PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# Puerto 5432 (Session pooler), no 6543 (Transaction pooler). El modo
# transaccion devuelve la conexion al pool entre transacciones, y el contexto
# de RLS (SET LOCAL) se perderia en el camino. env.ts tambien lo rechaza.

# Verificación real del certificado en `npm run db:apply`. Apunta al certificado
# de Supabase; si no se define, el script cifra pero no verifica, y lo avisa.
# Descárgalo de Dashboard -> Settings -> Database -> SSL Certificates.
# POSTGRES_CA_CERT_PATH="C:/ruta/al/supabase-ca.cer"


# --- JWT y sesiones ---------------------------------------------------------
#
# JWT_SECRET es la variable más importante del archivo. Genera una nueva:
#
#     node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#
# Mínimo 32 caracteres; 64 bytes en base64 es lo que pide la spec. Si se filtra,
# todos los access tokens emitidos son válidos hasta expirar, y no hay forma de
# invalidarlos sin cambiar la clave.

JWT_SECRET="PEGA_AQUI_EL_SALIDO_DEL_NODE_E"

# Vida del access token. Corto a propósito: se renueva con el refresh.
ACCESS_TOKEN_TTL_SECONDS=900

# Vida del refresh token, en días.
REFRESH_TOKEN_TTL_DAYS=30


# --- Argon2id (hash de contraseñas) ------------------------------------------
#
# Solo se cambian si el hardware no da para tanto. Subir la memoria de 64 MiB a
# 256 MiB multiplica por cuatro el coste de cada login.
#
# Para medir lo que aguanta tu máquina: `npm run test:unit` tarda ~1 s por hash a
# 64 MiB. Si un login tarda más de 200 ms de más, baja ARGON2_MEMORY_COST a 32768.

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4


# --- Cookie de refresh ------------------------------------------------------
#
# El refresh token viaja solo en esta cookie: httpOnly (inaccesible desde JS),
# secure (solo HTTPS), sameSite=strict (no acompaña peticiones de terceros).
#
# Path restringido a los endpoints de auth: fuera de ahí, la cookie no viaja.
# En producción, SameSite debe ser strict; env.ts se niega a arrancar con lax.

REFRESH_COOKIE_NAME="refresh_token"
REFRESH_COOKIE_PATH="/api/v1/auth"
REFRESH_COOKIE_SAMESITE="strict"

# Ponlo a false solo en desarrollo local con HTTP. En producción, true.
REFRESH_COOKIE_SECURE="true"


# --- Rate limit de login ----------------------------------------------------
#
# Cuenta intentos FALLIDOS por IP: 5 en 15 minutos. Los logins correctos no
# cuentan, porque entrar y salir varias veces no es un ataque.

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000


# --- Supabase (solo para Storage y administracion) --------------------------
# Dashboard -> Project Settings -> API Keys.

SUPABASE_URL="https://TU_PROJECT_REF.supabase.co"

# Publishable key (antes "anon key"). Esta SI puede ir en el frontend: con RLS
# activa, solo expone lo que las politicas ya permiten.
SUPABASE_ANON_KEY="PENDING"

# Service role. SOLO en el backend. Da bypass de RLS: quien la tenga lee y
# escribe en todas las comunidades sin restriccion. Nunca en el bundle del
# cliente.
SUPABASE_SERVICE_ROLE_KEY="PENDING"

# --- Storage de documentos (spec 08 §9) --------------------------------------
# `supabase` firma URLs contra el bucket; `local` vuelca los archivos a una
# carpeta temporal. Sin claves reales, pon `local` aquí: con `supabase` el
# arranque falla antes que la primera petición. En tests este valor se IGNORA:
# el driver es siempre `local`, pase lo que pase en este archivo (D-6).
STORAGE_DRIVER="supabase"

# Bucket y validez de la signed URL de descarga, en segundos.
DOCUMENTS_BUCKET="community-documents"
DOCUMENTS_SIGNED_URL_EXPIRES_IN=300


# --- APIs externas ----------------------------------------------------------
# Solo se rellenan cuando toque la funcionalidad correspondiente.
# Ninguna tiene coste dentro de los limites del plan gratuito.

# Proveedor de IA. Groq es el principal, Gemini el de respaldo.
GROQ_API_KEY="PENDING"
GEMINI_API_KEY="PENDING"

# El modelo de Groq no cambia nunca dentro del proyecto.
GROQ_MODEL="llama-3.3-70b-versatile"

# Sin clave: Open-Meteo y Photon son de acceso publico.
OPEN_METEO_URL="https://api.open-meteo.com/v1/forecast"
PHOTON_URL="https://photon.komoot.io/api/"
