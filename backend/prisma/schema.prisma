  updated_at             DateTime         @default(now()) @db.Timestamptz(6)
  area_slots             AreaSlots[]
  communities            Communities      @relation(fields: [community_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                  Users?           @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  reservations           Reservations[]

  @@index([community_id], map: "common_areas_community_idx")
  @@map("common_areas")
